{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Run Backend (dev)",
      "type": "shell",
      "command": "npm run start:dev",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "group": "dev",
        "reveal": "always",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "🚀 Run Frontend (dev)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "group": "dev",
        "reveal": "always",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "🚀 Run BOTH (full stack)",
      "dependsOn": ["🚀 Run Backend (dev)", "🚀 Run Frontend (dev)"],
      "presentation": { "group": "dev" },
      "problemMatcher": []
    },
    {
      "label": "🔨 Build Backend",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "🔨 Build Frontend",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "🔍 Type-check Frontend",
      "type": "shell",
      "command": "npx tsc --noEmit",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "📤 Deploy to Vercel (Production)",
      "type": "shell",
      "command": "npx vercel --prod --yes --force",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
